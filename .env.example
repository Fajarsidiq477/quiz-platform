# Copy to .env (git-ignored) and fill in. Never commit real values.

# App connection. Use a role that is NOT the table owner and NOT a superuser, or row-level
# security is skipped.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/quiz_platform

# Privileged connection (superuser or BYPASSRLS) used only by CLI scripts such as
# `npm run user:create`. Falls back to DATABASE_URL if unset.
DATABASE_ADMIN_URL=

# Auth.js. Generate the secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
